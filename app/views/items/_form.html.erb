<%= form_with(model: item, class: "space-y-6 bg-white p-8 shadow rounded-xl") do |f| %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="md:col-span-2">
      <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :sku, "SKU / Part Number", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :sku, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :item_category_id, "Category", class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :item_category_id, ItemCategory.all, :id, :name, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :unit_price, "Sales Price", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :unit_price, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :cost_price, "Purchase Cost", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :cost_price, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>
  </div>

  <div class="flex justify-end space-x-4">
    <%= link_to 'Back', items_path, class: "px-4 py-2 text-gray-600" %>
    <%= f.submit "Save Product", class: "bg-green-600 text-white px-6 py-2 rounded-lg font-bold" %>
  </div>
<% end %>