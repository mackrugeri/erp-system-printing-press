<div class="flex justify-between items-center mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Inventory Items</h1>
    <p class="text-sm text-gray-500">Manage products, raw materials, and stock levels.</p>
  </div>
  <%= link_to 'Add New Item', new_item_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-semibold shadow-sm transition" %>
</div>

<div class="bg-white shadow-sm border border-gray-200 rounded-xl overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Item Details</th>
        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Category</th>
        <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Stock Level</th>
        <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Unit Price</th>
        <th class="px-6 py-3 text-center text-xs font-bold text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @items.each do |item| %>
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="flex flex-col">
              <span class="text-sm font-bold text-gray-900"><%= item.name %></span>
              <span class="text-xs font-mono text-gray-400"><%= item.sku %></span>
            </div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-600 rounded">
              <%= item.item_category&.name || 'Uncategorized' %>
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right">
            <% if item.current_stock <= item.reorder_level %>
              <span class="text-sm font-bold text-red-600">
                <%= item.current_stock %> <span class="text-[10px] uppercase font-black">(Low)</span>
              </span>
            <% else %>
              <span class="text-sm font-bold text-gray-900"><%= item.current_stock %></span>
            <% end %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-mono text-gray-600">
            <%= number_to_currency(item.unit_price) %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
            <div class="flex justify-center space-x-3">
              <%= link_to item, class: "text-blue-600 hover:text-blue-900", title: "View History" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d=" eye-icon d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              <% end %>

              <%= link_to edit_item_path(item), class: "text-amber-600 hover:text-amber-900", title: "Edit Item" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              <% end %>

              <%= link_to item_path(item), 
                  data: { turbo_method: :delete, turbo_confirm: 'Are you sure? This will remove the item from the catalog.' }, 
                  class: "text-red-600 hover:text-red-900", title: "Delete Item" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>