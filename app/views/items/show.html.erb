<div class="grid grid-cols-3 gap-6 mb-8">
  <div class="col-span-2 bg-white p-8 rounded-xl shadow-sm border">
    <h2 class="text-2xl font-bold mb-4"><%= @item.name %></h2>
    <div class="grid grid-cols-2 gap-4 text-sm">
      <p><span class="text-gray-500">SKU:</span> <%= @item.sku %></p>
      <p><span class="text-gray-500">Category:</span> <%= @item.item_category.name %></p>
      <p><span class="text-gray-500">Unit Price:</span> <%= number_to_currency(@item.unit_price) %></p>
      <p><span class="text-gray-500">Cost Price:</span> <%= number_to_currency(@item.cost_price) %></p>
    </div>
  </div>
  <div class="bg-slate-900 text-white p-8 rounded-xl shadow-sm flex flex-col justify-center items-center">
    <p class="text-sm uppercase opacity-70">Stock on Hand</p>
    <p class="text-5xl font-bold"><%= @item.current_stock %></p>
  </div>
</div>

<h3 class="text-lg font-bold mb-4">Stock Movement History</h3>
<div class="bg-white border rounded-lg overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b">
      <tr class="text-left text-gray-600">
        <th class="p-4">Timestamp</th>
        <th class="p-4">Type</th>
        <th class="p-4">Warehouse</th>
        <th class="p-4 text-right">Change</th>
      </tr>
    </thead>
    <tbody>
      <% @stock_history.each do |tx| %>
        <tr class="border-b hover:bg-gray-50">
          <td class="p-4 text-gray-500"><%= tx.created_at.strftime("%b %d, %Y") %></td>
          <td class="p-4 uppercase text-xs font-bold text-slate-600"><%= tx.transaction_type %></td>
          <td class="p-4"><%= tx.warehouse&.name %></td>
          <td class="p-4 text-right font-bold <%= tx.quantity > 0 ? 'text-green-600' : 'text-red-600' %>">
            <%= tx.quantity %>
          </td>
          <td class="p-4 text-right space-x-3">
            <%= link_to 'Edit', edit_stock_transaction_path(tx), class: "text-blue-600 hover:text-blue-900 font-medium" %>
            <%= link_to 'Delete', tx, data: { turbo_method: :delete, turbo_confirm: 'Are you sure? This will change the current stock balance.' }, class: "text-red-400 hover:text-red-600 font-medium" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>