<div class="max-w-4xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Item Categories</h1>
    <%= link_to 'New Category', new_item_category_path, class: "text-sm bg-gray-100 px-3 py-1 rounded hover:bg-gray-200" %>
  </div>

  <div class="bg-white shadow rounded-xl overflow-hidden">
    <table class="w-full text-left">
      <thead class="bg-gray-50 border-b">
        <tr>
          <th class="p-4 text-sm font-semibold text-gray-600">Category Name</th>
          <th class="p-4 text-sm font-semibold text-gray-600">Description</th>
          <th class="p-4 text-sm font-semibold text-gray-600">Item Count</th>
          <th class="p-4"></th>
        </tr>
      </thead>
      <tbody>
        <% @item_categories.each do |category| %>
          <tr class="border-b">
            <td class="p-4 font-medium"><%= category.name %></td>
            <td class="p-4 text-sm text-gray-500"><%= category.description %></td>
            <td class="p-4 text-sm"><%= category.items.count %></td>
            <td class="p-4 text-right">
              <%= link_to 'Edit', edit_item_category_path(category), class: "text-blue-600 mr-3" %>
              <%= link_to 'Delete', category, data: { turbo_method: :delete, turbo_confirm: 'Delete this category?' }, class: "text-red-600" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>