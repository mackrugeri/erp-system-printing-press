<%# app/views/purchase_bills/index.html.erb %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  
  <%# 1. Header Section %>
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight italic uppercase">Purchase Bills</h1>
      <p class="text-slate-500 mt-1">Manage vendor liabilities and inventory intake.</p>
    </div>
    <%= link_to new_purchase_bill_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg font-semibold shadow-sm transition flex items-center" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Record New Bill
    <% end %>
  </div>

  <%# 2. Stats Cards %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Total Purchases</span>
      <div class="text-3xl font-black text-slate-900 mt-1"><%= number_to_currency(@total_billed || @purchase_bills.sum(&:total_amount)) %></div>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Active Range</span>
      <div class="text-sm font-medium text-slate-600 mt-2">
        <%= @start_date.to_date.strftime("%b %d") %> — <%= @end_date.to_date.strftime("%b %d, %Y") %>
      </div>
    </div>
  </div>

  <%# 3. Filter Bar %>
  <div class="bg-slate-100 rounded-xl p-4 mb-6 flex flex-wrap items-end justify-between gap-4">
    <%= form_with url: purchase_bills_path, method: :get, class: "flex items-end gap-4" do |f| %>
      <div>
        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">From</label>
        <%= f.date_field :start_date, value: @start_date, class: "rounded-md border-slate-300 text-sm shadow-sm focus:ring-blue-500" %>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">To</label>
        <%= f.date_field :end_date, value: @end_date, class: "rounded-md border-slate-300 text-sm shadow-sm focus:ring-blue-500" %>
      </div>
      <%= f.submit "Filter", class: "bg-slate-800 text-white px-4 py-2 rounded-md text-sm font-bold hover:bg-slate-700 cursor-pointer" %>
    <% end %>

    <div class="flex gap-2">
      <%= link_to purchase_bills_path(format: :csv, start_date: @start_date, end_date: @end_date), class: "bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-md text-sm font-bold hover:bg-slate-50 flex items-center" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        Export CSV
      <% end %>
    </div>
  </div>

  <%# 4. Bill Listing Table %>
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-4 text-left text-[10px] font-black text-slate-500 uppercase tracking-widest">Date</th>
            <th class="px-6 py-4 text-left text-[10px] font-black text-slate-500 uppercase tracking-widest">Bill #</th>
            <th class="px-6 py-4 text-left text-[10px] font-black text-slate-500 uppercase tracking-widest">Vendor</th>
            <th class="px-6 py-4 text-left text-[10px] font-black text-slate-500 uppercase tracking-widest">Status</th>
            <th class="px-6 py-4 text-right text-[10px] font-black text-slate-500 uppercase tracking-widest">Total</th>
            <th class="px-6 py-4 text-right text-[10px] font-black text-slate-500 uppercase tracking-widest">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @purchase_bills.each do |bill| %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">
                <%= bill.date&.strftime("%b %d, %Y") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm font-black text-slate-900"><%= bill.bill_number %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-bold text-slate-700"><%= bill.contact&.name %></div>
                <div class="text-[10px] text-slate-400 font-medium italic">Vendor</div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% display_status = bill.status.presence || 'Draft' %>
                <span class="px-3 py-1 rounded-full text-[10px] font-black <%= display_status == 'Posted' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                  <%= display_status.upcase %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right font-mono font-black text-slate-900">
                <%= number_to_currency(bill.total_amount) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end gap-3">
                  <%= link_to "View", purchase_bill_path(bill), class: "text-blue-600 hover:text-blue-900 font-bold" %>
                  <% unless bill.status == 'Posted' %>
                    <%= link_to "Edit", edit_purchase_bill_path(bill), class: "text-slate-400 hover:text-slate-600 font-bold" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <% if @purchase_bills.empty? %>
      <div class="py-20 text-center">
        <p class="text-slate-400 font-medium italic">No purchase bills found for this period.</p>
      </div>
    <% end %>
  </div>
</div>