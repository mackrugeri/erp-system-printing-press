<%= form_with(model: contact, class: "space-y-6") do |f| %>
  
  <%# Error Handling %>
  <% if contact.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-lg">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-bold text-red-800">Please correct the following:</h3>
          <ul class="text-xs text-red-700 list-disc ml-5 mt-1">
            <% contact.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <%= f.hidden_field :contact_type %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
    
    <%# Full Name Input %>
    <div class="col-span-2">
      <%= f.label :name, class: "block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2" %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <span class="text-slate-400">👤</span>
        </div>
        <%= f.text_field :name, 
            placeholder: "Enter legal name or company...",
            class: "block w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all duration-200" %>
      </div>
    </div>

    <%# Email Input %>
    <div>
      <%= f.label :email, class: "block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2" %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <span class="text-slate-400">✉️</span>
        </div>
        <%= f.email_field :email, 
            placeholder: "name@company.com",
            class: "block w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all duration-200" %>
      </div>
    </div>

    <%# Phone Input %>
    <div>
      <%= f.label :phone, class: "block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2" %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-xs">
          <span class="text-slate-400 font-bold ml-1">#</span>
        </div>
        <%= f.text_field :phone, 
            placeholder: "+1 (555) 000-0000",
            class: "block w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all duration-200" %>
      </div>
    </div>

    <%# Address Textarea %>
    <div class="col-span-2">
      <%= f.label :address, class: "block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2" %>
      <%= f.text_area :address, 
          rows: 3, 
          placeholder: "Street, City, State, ZIP...",
          class: "block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:bg-white transition-all duration-200" %>
    </div>
  </div>

  <%# Form Actions %>
  <div class="pt-8 mt-8 border-t border-slate-100 flex items-center justify-between">
    <p class="text-[10px] text-slate-400 italic">* All information is synced with the Chart of Accounts.</p>
    <div class="flex gap-4">
      <%= link_to "Cancel", contacts_path, class: "px-6 py-3 text-sm font-bold text-slate-400 hover:text-slate-600 transition" %>
      <%= f.submit class: "px-10 py-3 bg-slate-900 text-white text-sm font-black rounded-xl hover:bg-blue-600 hover:shadow-lg hover:shadow-blue-200 transition-all cursor-pointer" %>
    </div>
  </div>
<% end %>