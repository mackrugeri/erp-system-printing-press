<div class="max-w-3xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">Fiscal Periods & Year End</h1>
  
  <div class="space-y-4">
    <% @fiscal_periods.each do |period| %>
      <div class="bg-white p-6 rounded-xl border-2 <%= period.closed? ? 'border-gray-200 bg-gray-50' : 'border-green-200' %> flex justify-between items-center">
        <div>
          <h3 class="text-lg font-bold"><%= period.name %></h3>
          <p class="text-sm text-gray-500"><%= period.start_date.strftime("%b %Y") %> - <%= period.end_date.strftime("%b %Y") %></p>
        </div>
        
        <div>
          <% if period.closed? %>
            <span class="px-3 py-1 bg-gray-200 text-gray-700 rounded-full text-xs font-bold uppercase">Locked</span>
          <% else %>
            <%= button_to "Close Period", close_fiscal_period_path(period), method: :post, 
                data: { confirm: "Warning: Closing the period prevents any further changes to the ledger for this date range. Continue?" },
                class: "bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-bold shadow-sm" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-8 p-6 bg-blue-50 rounded-xl border border-blue-100">
    <h4 class="text-blue-800 font-bold mb-2 text-sm">Create New Period</h4>
    <%= form_with(model: FiscalPeriod.new, class: "grid grid-cols-3 gap-4") do |f| %>
      <%= f.text_field :name, placeholder: "FY 2026", class: "rounded border-blue-200" %>
      <%= f.date_field :start_date, class: "rounded border-blue-200 text-sm" %>
      <%= f.submit "Open Year", class: "bg-blue-600 text-white rounded font-bold" %>
    <% end %>
  </div>
</div>