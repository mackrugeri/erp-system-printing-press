<div class="flex justify-between items-center mb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Storage Locations</h1>
    <p class="text-sm text-gray-500">Manage factory sections, raw material stores, and finished goods areas.</p>
  </div>
  <%= link_to 'Add New Warehouse', new_warehouse_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-semibold shadow-sm transition" %>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <% @warehouses.each do |warehouse| %>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex flex-col justify-between">
      <div>
        <div class="flex justify-between items-start mb-4">
          <div class="bg-slate-100 p-2 rounded-lg text-slate-600">
            <span class="text-xl">🏢</span>
          </div>
          <div class="flex space-x-2">
            <%= link_to edit_warehouse_path(warehouse), class: "text-gray-400 hover:text-amber-600" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            <% end %>
            <%= link_to warehouse, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "text-gray-400 hover:text-red-600" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          </div>
        </div>
        <h3 class="text-lg font-bold text-gray-900"><%= warehouse.name %></h3>
        <p class="text-sm text-gray-500 mb-4"><%= warehouse.location %></p>
      </div>
      
      <div class="border-t pt-4 flex justify-between items-center">
        <span class="text-xs font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded">
          <%= warehouse.stock_transactions.sum(:quantity) %> Units
        </span>
        <%= link_to 'View Stock →', warehouse_path(warehouse), class: "text-sm font-semibold text-gray-600 hover:text-blue-600" %>
      </div>
    </div>
  <% end %>
</div>