<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">Chart of Accounts</h1>
  <%= link_to 'New Account', new_account_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg" %>
</div>
<table class="w-full bg-white rounded-xl shadow-sm overflow-hidden">
  <thead class="bg-gray-50 border-b">
    <tr>
      <th class="p-4 text-left">Code</th>
      <th class="p-4 text-left">Account Name</th>
      <th class="p-4 text-left">Type</th>
      <th class="p-4 text-right">Opening Balance</th>
      <th class="p-4 text-center">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @accounts.each do |account| %>
      <tr class="border-b hover:bg-gray-50">
        <td class="p-4 font-mono text-sm"><%= account.code %></td>
        <td class="p-4 font-medium"><%= link_to account.name, account %></td>
        <td class="p-4"><span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full"><%= account.account_type %></span></td>
        <td class="p-4 text-right font-bold"><%= number_to_currency(account.balance) %></td>
        <td class="p-4 text-center space-x-3">
          <%= link_to 'Edit', edit_account_path(account), class: "text-blue-600 hover:underline text-sm font-medium" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>