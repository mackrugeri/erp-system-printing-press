<div class="mb-6 flex justify-between items-end">
  <div>
    <h1 class="text-3xl font-bold text-gray-900"><%= @account.name %></h1>
    <p class="text-gray-500">Account Code: <%= @account.code %></p>
  </div>
</div>

<div class="bg-white shadow-sm border rounded-xl overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Debit</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Credit</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @ledger_entries.each do |entry| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= entry.journal_entry.date %></td>
          <td class="px-6 py-4 text-sm text-gray-900">
            <span class="font-medium"><%= entry.journal_entry.description %></span>
            <div class="text-xs text-gray-400"><%= entry.journal_entry.reference %></div>
          </td>
          <td class="px-6 py-4 text-right text-sm font-mono text-green-600"><%= number_to_currency(entry.debit) if entry.debit > 0 %></td>
          <td class="px-6 py-4 text-right text-sm font-mono text-red-600"><%= number_to_currency(entry.credit) if entry.credit > 0 %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>