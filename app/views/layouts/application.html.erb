<!DOCTYPE html>
<html class="h-full bg-gray-50">
  <head>
    <title>Core ERP</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-full">
    <div class="min-h-full flex">
      <div class="w-64 bg-slate-900 fixed inset-y-0">
        <div class="p-6 text-white font-bold text-xl border-b border-slate-800">CORE ERP</div>
        <%= render 'layouts/sidebar' %>
      </div>
      <div class="pl-64 flex-1">
        <main class="p-8"><%= yield %></main>
      </div>
    </div>
  </body>
</html>
</html>