<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: 'Helvetica', 'Arial', sans-serif; font-size: 12px; color: #333; }
    .header-table { width: 100%; border-bottom: 2px solid #000; margin-bottom: 20px; }
    .item-table { width: 100%; border-collapse: collapse; }
    .item-table th { background: #f1f5f9; border-bottom: 1px solid #cbd5e1; padding: 10px; text-align: left; font-size: 10px; }
    .item-table td { padding: 10px; border-bottom: 1px solid #f1f5f9; }
    .total-section { margin-top: 30px; text-align: right; border-top: 2px solid #000; padding-top: 10px; }
    .ledger-section { background: #0f172a; color: white; padding: 20px; margin-top: 40px; }
    .text-right { text-align: right; }
    .font-bold { font-weight: bold; }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>