<%# app/views/productions/new.html.erb %>
<div class="max-w-2xl mx-auto py-12 px-4">
  <div class="text-center mb-10">
    <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-3xl flex items-center justify-center mx-auto mb-4 shadow-inner">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
    </div>
    <h1 class="text-3xl font-black text-slate-900 uppercase italic tracking-tighter">New Production Run</h1>
    <p class="text-slate-500 font-medium">Record a batch of finished goods. Materials will be auto-deducted.</p>
  </div>

  <% if flash[:alert] %>
    <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-xl">
      <div class="flex items-center">
        <span class="text-red-500 mr-3">⚠️</span>
        <p class="text-sm text-red-700 font-bold"><%= flash[:alert] %></p>
      </div>
    </div>
  <% end %>

  <%= form_with url: productions_path, method: :post, local: true, class: "bg-white shadow-2xl rounded-[2.5rem] border border-slate-200 overflow-hidden" do |f| %>
    <div class="p-10 space-y-8">
      
      <%# Product Selection: Filters for items with a Bill of Materials %>
      <div>
        <div class="flex justify-between items-center mb-2">
          <%= f.label :item_id, "Product with BOM", class: "block text-xs font-black text-slate-400 uppercase tracking-widest" %>
          <span class="text-[10px] bg-slate-100 px-2 py-1 rounded text-slate-500 font-bold italic">Requirement 3.1: Finished Goods Only</span>
        </div>
        <%= f.collection_select :item_id, @items, :id, ->(i) { "#{i.name} — [#{i.sku}]" }, { prompt: "Select a Product to Manufacture..." }, 
            class: "w-full rounded-2xl border-slate-200 py-4 px-5 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 shadow-sm font-bold text-slate-700 appearance-none bg-no-repeat bg-[right_1.5rem_center] bg-[length:1em_1em]" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%# Warehouse Selection %>
        <div>
          <%= f.label :warehouse_id, "Target Warehouse", class: "block text-xs font-black text-slate-400 uppercase tracking-widest mb-2" %>
          <%= f.collection_select :warehouse_id, @warehouses, :id, :name, {}, 
              class: "w-full rounded-2xl border-slate-200 py-4 px-5 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 shadow-sm font-bold text-slate-700" %>
        </div>

        <%# Batch Quantity %>
        <div>
          <%= f.label :quantity, "Batch Quantity", class: "block text-xs font-black text-slate-400 uppercase tracking-widest mb-2" %>
          <%= f.number_field :quantity, step: :any, min: 0.01, placeholder: "0.00", required: true,
              class: "w-full rounded-2xl border-slate-200 py-4 px-5 focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 shadow-sm font-mono font-bold text-slate-700 text-lg" %>
        </div>
      </div>

      <%# Requirement 3.3 Integrity Warning %>
      <div class="bg-blue-50/50 p-6 rounded-3xl flex items-start gap-4 border border-blue-100/50">
        <div class="text-2xl mt-1">📊</div>
        <div>
          <p class="text-[11px] font-black text-blue-900 uppercase tracking-widest mb-1">Accounting & Stock Integrity</p>
          <p class="text-xs text-blue-800 leading-relaxed font-medium">
            Submitting this form will automatically <strong>Credit Raw Materials</strong> and <strong>Debit Finished Goods</strong> inventory accounts based on the current material costs.
          </p>
        </div>
      </div>
    </div>

    <%# Form Actions %>
    <div class="p-10 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
      <%= link_to "Cancel", productions_path, class: "text-sm font-black text-slate-400 uppercase tracking-widest hover:text-slate-900 transition-colors" %>
      
      <button type="submit" class="group relative bg-slate-900 hover:bg-black text-white px-10 py-4 rounded-2xl font-black uppercase tracking-tighter shadow-xl transform active:scale-95 transition-all flex items-center gap-3">
        <span>Post Production Run</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  <% end %>
</div>