<%# app/views/productions/show.html.erb %>
<div class="max-w-4xl mx-auto py-12 px-4">
  <div class="flex justify-between items-end mb-8">
    <div>
      <%= link_to productions_path, class: "text-xs font-bold text-blue-600 uppercase tracking-widest hover:underline" do %>
        ← Back to Logs
      <% end %>
      <h1 class="text-4xl font-black text-slate-900 tracking-tighter mt-2 uppercase italic">Production Detail</h1>
    </div>
    <div class="text-right">
      <p class="text-xs font-bold text-slate-400 uppercase mb-1">Status</p>
      <span class="bg-green-500 text-white px-4 py-1 rounded-full font-bold text-xs uppercase tracking-widest">Completed</span>
    </div>
  </div>

  <div class="bg-slate-900 rounded-3xl p-8 mb-8 text-white shadow-xl flex justify-between items-center">
    <div>
      <p class="text-blue-400 text-[10px] font-black uppercase tracking-widest mb-1">Manufactured Output</p>
      <h2 class="text-3xl font-black italic uppercase"><%= @output_transaction.item.name %></h2>
      <div class="flex gap-4 mt-2">
        <p class="text-slate-400 text-sm">Warehouse: <%= @output_transaction.warehouse.name %></p>
        <% if @journal %>
          <p class="text-blue-300 text-sm font-mono">
            GL Ref: <%= link_to @journal.reference, journal_entry_path(@journal), class: "underline hover:text-white" %>
          </p>
        <% end %>
      </div>
    </div>
    <div class="text-right">
      <p class="text-5xl font-black text-blue-400">+<%= @output_transaction.quantity %></p>
      <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-1">Units Produced</p>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
    <div class="p-6 border-b border-slate-100 bg-slate-50">
      <h3 class="font-black text-slate-800 uppercase tracking-tight">Material Consumption (BOM Deductions)</h3>
    </div>
    <table class="w-full text-left">
      <thead>
        <tr class="text-[10px] font-black text-slate-400 uppercase tracking-widest border-b">
          <th class="p-5">Raw Material</th>
          <th class="p-5 text-right">Qty Consumed</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @consumptions.each do |c| %>
          <tr>
            <td class="p-5">
              <p class="font-bold text-slate-900 text-sm"><%= c.item.name %></p>
              <p class="text-[10px] text-slate-500 font-mono"><%= c.item.sku %></p>
            </td>
            <td class="p-5 text-right font-mono font-bold text-red-500">
              <%= c.quantity.abs %> <%# Absolute value for user display %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>