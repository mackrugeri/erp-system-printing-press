<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold mb-6 text-center">Stock Adjustment</h1>

  <%= form_with(model: @stock_transaction, class: "bg-white p-8 shadow-lg rounded-xl space-y-4") do |f| %>
    
    <% if @stock_transaction.errors.any? %>
      <div class="bg-red-50 p-4 rounded-lg text-red-700 text-sm">
        <p class="font-bold">Please fix the following errors:</p>
        <ul class="list-disc ml-5">
          <% @stock_transaction.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :item_id, "Select Item", class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :item_id, @items, :id, :name, { prompt: "Choose an item..." }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :warehouse_id, "Warehouse Location", class: "block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :warehouse_id, @warehouses, :id, :name, { prompt: "Choose a warehouse..." }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :transaction_type, "Transaction Type", class: "block text-sm font-medium text-gray-700" %>
      <%= f.select :transaction_type, 
          [['Purchase (Stock In)', 'purchase'], 
           ['Sale (Stock Out)', 'sale'], 
           ['Damage/Waste (Stock Out)', 'waste'], 
           ['Manual Adjustment', 'adjustment']], 
          { prompt: "Select Type" }, 
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :quantity, "Quantity", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :quantity, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :notes, "Reason/Notes", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :notes, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <%= f.submit "Adjust Stock", class: "w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 cursor-pointer" %>
  <% end %>
</div>