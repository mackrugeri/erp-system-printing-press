<%= form_with(model: stock_transaction, class: "bg-white p-8 shadow-sm border border-gray-200 rounded-xl space-y-6") do |f| %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :item_id, "Inventory Item", class: "block text-sm font-semibold text-gray-700" %>
      <%= f.collection_select :item_id, Item.all, :id, :name, {}, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= f.label :warehouse_id, "Storage Location", class: "block text-sm font-semibold text-gray-700" %>
      <%= f.collection_select :warehouse_id, Warehouse.all, :id, :name, {}, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= f.label :transaction_type, "Movement Type", class: "block text-sm font-semibold text-gray-700" %>
      <%= f.select :transaction_type, [['Purchase', 'purchase'], ['Sale', 'sale'], ['Waste/Damage', 'waste'], ['Adjustment', 'adjustment']], {}, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= f.label :quantity, "Quantity", class: "block text-sm font-semibold text-gray-700" %>
      <%= f.number_field :quantity, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, "Reason for Change", class: "block text-sm font-semibold text-gray-700" %>
    <%= f.text_area :notes, rows: 3, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div class="pt-4">
    <%= f.submit "Save Changes", class: "w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-bold shadow-md cursor-pointer transition-all active:scale-95" %>
  </div>
<% end %>